# ASC メタデータ入力の自動化（#210/#211/#199/#201/#212）。
# バイナリは扱わない（TestFlight 配信は .github/workflows/ios-release.yml）。
default_platform(:ios)

APP_ID = "me.noshi.app"

platform :ios do
  desc "App Store Connect へメタデータ/スクショ/年齢レーティング/レビュー情報/プライバシーラベルを反映"
  lane :asc_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
    )

    # レビュー情報は常に渡す。deliver（2.237.0 で確認）はレビュー情報レコードが
    # 未作成のアプリだと review_attachment_file 内の fetch_app_store_review_detail が
    # 「No data」例外になるため、先に review_information でレコードを作らせて回避する。
    # デモアカウントは Secret（ASC_DEMO_PASSWORD）がある場合のみ設定。
    notes_path = File.expand_path("review_notes.txt", __dir__)
    raise "review_notes.txt が見つかりません: #{notes_path}" unless File.exist?(notes_path)
    review_info = { notes: File.read(notes_path) }
    if ENV["ASC_DEMO_PASSWORD"].to_s != ""
      review_info[:demo_user] = "appreview@noshi.me"
      review_info[:demo_password] = ENV["ASC_DEMO_PASSWORD"]
    end

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true, # HTML プレビュー確認を省略（CI）
      app_rating_config_path: File.expand_path("rating.json", __dir__),
      app_review_information: review_info,
    )

    upload_app_privacy_details_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      json_path: File.expand_path("app_privacy_details.json", __dir__),
    )
  end
end
