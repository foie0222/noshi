{
  "compilerOptions": {
    "target": "ES2020", "module": "node16", "lib": ["ES2020"],
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    // TS7 で node10 が廃止されたため node16 へ（package.json に type:module が無いので CJS 出力のまま）
    "moduleResolution": "node16", "resolveJsonModule": true,
    // TS6 で global な @types/node が自動取り込みされなくなったため明示（fs/path/__dirname 等）
    "types": ["node"],
    "outDir": "dist", "rootDir": "."
  },
  "include": ["bin", "lib"]
}
