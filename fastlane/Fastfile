# ASC メタデータ入力の自動化（#210/#211/#199/#201/#212）。
# バイナリは扱わない（TestFlight 配信は .github/workflows/ios-release.yml）。
default_platform(:ios)

APP_ID = "me.noshi.app"

platform :ios do
  desc "App Store Connect へメタデータ/スクショ/年齢レーティング/レビュー情報/プライバシーラベルを反映"
  lane :asc_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
    )

    # レビュー情報（審査ノート・デモアカウント・審査連絡先）。
    # レビュー情報レコード自体は初回実行で作成済み（notes 反映済み）。ASC API は
    # レコードの「更新」時に contactLastName 等の連絡先を必須にするため、
    # デモパスワードと連絡先の Secret がすべて揃った場合のみ送信し、
    # 揃わない場合は警告してスキップする（レーンは継続、既存の入力値は保持）。
    notes_path = File.expand_path("review_notes.txt", __dir__)
    raise "review_notes.txt が見つかりません: #{notes_path}" unless File.exist?(notes_path)
    required_envs = %w[ASC_DEMO_PASSWORD ASC_CONTACT_FIRST_NAME ASC_CONTACT_LAST_NAME ASC_CONTACT_PHONE ASC_CONTACT_EMAIL]
    missing = required_envs.select { |k| ENV[k].to_s.strip.empty? }
    if missing.empty?
      review_info = {
        notes: File.read(notes_path),
        demo_user: "appreview@noshi.me",
        demo_password: ENV["ASC_DEMO_PASSWORD"],
        first_name: ENV["ASC_CONTACT_FIRST_NAME"],
        last_name: ENV["ASC_CONTACT_LAST_NAME"],
        phone_number: ENV["ASC_CONTACT_PHONE"],
        email_address: ENV["ASC_CONTACT_EMAIL"],
      }
    else
      review_info = nil
      UI.important("レビュー情報の更新をスキップ: Secret 未設定 → #{missing.join(', ')}")
    end

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true, # HTML プレビュー確認を省略（CI）
      app_rating_config_path: File.expand_path("rating.json", __dir__),
      **(review_info ? { app_review_information: review_info } : {}),
    )

    # App Privacy 栄養ラベルの反映。標準アクション upload_app_privacy_details_to_app_store は
    # Apple ID ログイン専用（2.237.0 時点で Spaceship::ConnectAPI.login を無条件に呼ぶ）のため、
    # API キー認証（app_store_connect_api_key が set_spaceship_token でトークン設定済み）で
    # 同アクションの中核処理（delete → create → publish）をそのまま実行する。
    require "spaceship"
    require "json"
    privacy_json_path = File.expand_path("app_privacy_details.json", __dir__)
    raise "app_privacy_details.json が見つかりません: #{privacy_json_path}" unless File.exist?(privacy_json_path)
    usages_config = JSON.parse(File.read(privacy_json_path))
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} が見つかりません") unless app

    # .all は all_pages で全ページを辿るため件数切り捨てはない（limit はページサイズ）
    Spaceship::ConnectAPI::AppDataUsage.all(
      app_id: app.id, includes: "category,grouping,purpose,dataProtection"
    ).each(&:delete!)

    usages_config.each do |usage_config|
      purposes = usage_config["purposes"] || []
      purposes = [nil] if purposes.empty? # 「収集しない」もレコード作成が必要
      purposes.each do |purpose|
        (usage_config["data_protections"] || []).each do |data_protection|
          UI.message("Setting #{usage_config['category']} / #{purpose} to #{data_protection}")
          Spaceship::ConnectAPI::AppDataUsage.create(
            app_id: app.id,
            app_data_usage_category_id: usage_config["category"],
            app_data_usage_protection_id: data_protection,
            app_data_usage_purpose_id: purpose,
          )
        end
      end
    end

    publish_state = Spaceship::ConnectAPI::AppDataUsagesPublishState.get(app_id: app.id)
    if publish_state.published
      UI.important("App data usage is already published")
    else
      publish_state.publish!
      UI.important("App data usage is now published")
    end
  end
end
