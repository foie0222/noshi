# ASC メタデータ入力の自動化（#210/#211/#199/#201/#212）。
# バイナリは扱わない（TestFlight 配信は .github/workflows/ios-release.yml）。
default_platform(:ios)

APP_ID = "me.noshi.app"

platform :ios do
  desc "App Store Connect へメタデータ/スクショ/年齢レーティング/レビュー情報/プライバシーラベルを反映"
  lane :asc_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
    )

    # レビュー情報は常に渡す。deliver はレビュー情報レコードが未作成のアプリで
    # review_attachment_file の fetch が「No data」例外になるため（2.237.0 の
    # upload_metadata.rb:752）、先に review_information でレコードを作らせて回避する。
    # デモアカウントは Secret（ASC_DEMO_PASSWORD）がある場合のみ設定。
    review_info = { notes: File.read(File.expand_path("review_notes.txt", __dir__)) }
    if ENV["ASC_DEMO_PASSWORD"].to_s != ""
      review_info[:demo_user] = "appreview@noshi.me"
      review_info[:demo_password] = ENV["ASC_DEMO_PASSWORD"]
    end

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true, # HTML プレビュー確認を省略（CI）
      app_rating_config_path: File.expand_path("rating.json", __dir__),
      app_review_information: review_info,
    )

    upload_app_privacy_details_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      json_path: File.expand_path("app_privacy_details.json", __dir__),
    )
  end
end
